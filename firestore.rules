rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Your personal notebooks: only you can read and write them
    match /lingoNotebook/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Shared notebooks: everyone in "members" can read and write the words
    match /sharedNotebooks/{nbId} {
      allow create: if request.auth != null
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members == [request.auth.uid];

      allow read: if request.auth != null && request.auth.uid in resource.data.members;

      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;

      allow update: if request.auth != null && (
        // the owner may change everything
        resource.data.owner == request.auth.uid
        // members may write words, notes and their own profile, but not change who is in the notebook
        || (request.auth.uid in resource.data.members
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['owner', 'members', 'inviteCode', 'known', 'targetName']))
        // a member may leave
        || (request.auth.uid in resource.data.members
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberInfo'])
            && !(request.auth.uid in request.resource.data.members)
            && request.resource.data.members.size() == resource.data.members.size() - 1)
        // someone with the correct invite code may join (adds only themselves)
        || (!(request.auth.uid in resource.data.members)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberInfo', 'lastJoinCode'])
            && request.resource.data.lastJoinCode == resource.data.inviteCode
            && request.auth.uid in request.resource.data.members
            && request.resource.data.members.hasAll(resource.data.members)
            && request.resource.data.members.size() == resource.data.members.size() + 1)
      );
    }
  }
}
